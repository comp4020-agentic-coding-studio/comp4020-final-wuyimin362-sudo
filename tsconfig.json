{
  // Astro's strict preset covers the app in src/, and the supplied harness
  // (spec/, scripts/) rides along: `pnpm typecheck` runs `astro check` for the
  // .astro files and `tsc` for everything else.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "*.ts", "src", "spec", "scripts"],
  "exclude": ["dist", "node_modules"]
}
