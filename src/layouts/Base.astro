---
// Every page's frame: the landmarks, the app's name, and the note that this
// is not the club's own site.
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f7" />
    <meta
      name="description"
      content="An unofficial board where ACT table tennis club members post a time and a table, and another member takes them up on it."
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="global-nav">
      <div class="nav-inner">
        <a class="brand" href="/">Find a game</a>
        <nav aria-label="Site">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Board</a>
          <a href="/readme/" aria-current={path.startsWith("/readme") ? "page" : undefined}>About</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <p>An unofficial board for ACT table tennis club members. It isn't run by the club.</p>
    </footer>
  </body>
</html>
