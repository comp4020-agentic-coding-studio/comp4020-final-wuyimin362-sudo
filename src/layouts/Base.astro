---
// Every page's frame: the landmarks, the app's name, and the note that this
// is not the club's own site.
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Find a game</a>
      <nav aria-label="Site">
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Board</a>
        <a href="/readme/" aria-current={path.startsWith("/readme") ? "page" : undefined}>About</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>An unofficial board for ACT table tennis club members. It isn't run by the club.</p>
    </footer>
  </body>
</html>
