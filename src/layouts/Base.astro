---
// Every page's frame: the landmarks, the app's name, who's signed in, and the
// note that this is not the club's own site.
import "../styles.css";
import { invitationsFor } from "../lib/games";
import { waitingFor } from "../lib/matches";
import { currentPlayer, isGuest } from "../lib/players";

interface Props {
  title: string;
  // a page that must have no way to send anything, like the venues page, which
  // asks the browser where you are: it leaves out the member's live stream
  quiet?: boolean;
}

const { title, quiet = false } = Astro.props;
const path = Astro.url.pathname;
const player = currentPlayer(Astro.cookies);
// reports waiting for a member to confirm, flagged in the header
const waiting = player && !isGuest(player) ? waitingFor(player.id).length : 0;
// and invitations waiting for an answer
const invited = player && !isGuest(player) ? invitationsFor(player.id).length : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f7" />
    <meta
      name="description"
      content="An unofficial board where ACT table tennis club members post a time and a table, and another member takes them up on it."
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="global-nav">
      <div class="nav-inner">
        <a class="brand" href="/">Find a game</a>
        <nav aria-label="Site">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Board</a>
          <a href="/venues" aria-current={path === "/venues" ? "page" : undefined}>Venues</a>
          <a href="/players" aria-current={path === "/players" ? "page" : undefined}>Players</a>
          <a href="/events" aria-current={path === "/events" ? "page" : undefined}>Events</a>
          <a href="/readme/" aria-current={path.startsWith("/readme") ? "page" : undefined}>About</a>
        </nav>
        <div class="account">
          {
            player ? (
              <>
                <span class="who">
                  {isGuest(player) ? (
                    <>
                      {player.name}
                      {" "}
                      <span class="badge">Guest</span>
                    </>
                  ) : (
                    <a href="/profile" aria-current={path === "/profile" ? "page" : undefined}>
                      {player.name}
                    </a>
                  )}
                </span>
                {isGuest(player) ? (
                  <a href="/signup">Make an account</a>
                ) : (
                  <a href="/invites" data-live-count="invites" aria-current={path === "/invites" ? "page" : undefined}>
                    Invites
                    {invited > 0 && (
                      <>
                        {" "}
                        <span class="badge badge-alert">{invited} new</span>
                      </>
                    )}
                  </a>
                )}
                {!isGuest(player) && (
                  <a href="/matches" data-live-count="matches" aria-current={path === "/matches" ? "page" : undefined}>
                    Matches
                    {waiting > 0 && (
                      <>
                        {" "}
                        <span class="badge badge-alert">{waiting} to confirm</span>
                      </>
                    )}
                  </a>
                )}
                <form method="post" action="/logout">
                  <button class="link-button" type="submit">
                    Log out
                  </button>
                </form>
              </>
            ) : (
              <>
                <a href="/login" aria-current={path === "/login" ? "page" : undefined}>
                  Log in
                </a>
                <a href="/signup" aria-current={path === "/signup" ? "page" : undefined}>
                  Sign up
                </a>
              </>
            )
          }
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <p>An unofficial board for ACT table tennis club members. It isn't run by the club.</p>
    </footer>
    {
      player && !isGuest(player) && !quiet && (
        <>
          <p class="visually-hidden" aria-live="polite" data-live-me-status></p>
          <script is:inline>
            // A member's own changes stay live on every page: an invitation or
            // a match report waiting on them, or the answer to one they sent,
            // arrives on their own stream, and the page fetches itself again
            // to take the header's fresh counts and swap in any list marked
            // data-live-area. Forms are left alone, so nothing half-typed is
            // lost. Without JavaScript the counts and lists catch up on the
            // next page load.
            (() => {
              if (!("EventSource" in window)) return;
              const status = document.querySelector("[data-live-me-status]");
              let busy = false;
              let again = false;
              const refresh = async () => {
                if (busy) {
                  again = true;
                  return;
                }
                busy = true;
                try {
                  const res = await fetch(location.pathname, { headers: { accept: "text/html" } });
                  if (!res.ok) return;
                  const fresh = new DOMParser().parseFromString(await res.text(), "text/html");
                  // the links stay put, so focus stays on them; only their counts change
                  for (const link of document.querySelectorAll("[data-live-count]")) {
                    const next = fresh.querySelector('[data-live-count="' + link.dataset.liveCount + '"]');
                    if (next) link.innerHTML = next.innerHTML;
                  }
                  for (const area of document.querySelectorAll("[data-live-area]")) {
                    const next = fresh.getElementById(area.id);
                    if (next) area.replaceWith(next);
                  }
                  if (status) status.textContent = "Your invites or matches just changed.";
                } catch {
                  // the next change, or a reload, catches up
                } finally {
                  busy = false;
                  if (again) {
                    again = false;
                    refresh();
                  }
                }
              };
              const source = new EventSource("/live/me");
              let opened = false;
              source.addEventListener("change", refresh);
              source.addEventListener("open", () => {
                if (opened) refresh();
                opened = true;
              });
            })();
          </script>
        </>
      )
    }
  </body>
</html>
