---
// A member's matches: reports waiting for them to answer, a form to record a
// match, their own reports still waiting, and their confirmed record. Guests'
// matches aren't rated, so guests make an account first.
import Base from "../../layouts/Base.astro";
import {
  type MatchProblem,
  RECORD_DAYS,
  recordMatch,
  recordOf,
  recordWindow,
  waitingFor,
  waitingOn,
} from "../../lib/matches";
import { currentPlayer, isGuest } from "../../lib/players";
import { reviewedBy } from "../../lib/reviews";
import { formatDay } from "../../lib/time";
import { states, venueLabel, venues } from "../../lib/venues";

const player = currentPlayer(Astro.cookies);
if (!player) return Astro.redirect("/login", 303);
if (isGuest(player)) return Astro.redirect("/signup", 303);

const problems: Record<MatchProblem, string> = {
  opponent: "No member has that username. Only matches between members are rated.",
  self: "You can't record a match against yourself.",
  date: `Pick a date in the last ${RECORD_DAYS} days.`,
  venue: "Pick a venue from the list.",
  score: "That isn't a score a match ends on: the winner takes 2, 3 or 4 games, and more than the loser.",
  gone: "That match isn't waiting for you any more.",
};
const notices: Record<string, string> = {
  recorded: "Recorded. It counts once your opponent confirms it.",
  confirmed: "Confirmed. It's on both your records now.",
  disputed: "Disputed. It won't count.",
  reviewed: "Thanks. Your review is in.",
};
const pick = (messages: Record<string, string>, key: string | null) =>
  key && Object.hasOwn(messages, key) ? messages[key] : undefined;

const range = recordWindow();
let problem = pick(problems, Astro.url.searchParams.get("problem"));
let values = { opponent: "", playedOn: range.max, venue: "", mine: "3", theirs: "0" };
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const field = (name: string) => String(form.get(name) ?? "");
  values = {
    opponent: field("opponent"),
    playedOn: field("playedOn"),
    venue: field("venue"),
    mine: field("mine"),
    theirs: field("theirs"),
  };
  const result = recordMatch(player, values);
  if (!result) return Astro.redirect("/matches?done=recorded", 303);
  problem = problems[result];
  Astro.response.status = 400;
}
const done = pick(notices, Astro.url.searchParams.get("done"));
const toAnswer = waitingFor(player.id);
const ownReports = waitingOn(player.id);
const record = recordOf(player.id);
const reviewed = reviewedBy(player.id);
const gameCounts = ["0", "1", "2", "3", "4"];
---

<Base title="Matches · Find a game">
  <main class="wrap narrow">
    <section class="hero hero-small">
      <h1>Matches.</h1>
      <p class="lede">Record a match you've played. It counts once your opponent confirms it.</p>
    </section>

    {done && <p class="notice" role="status">{done}</p>}
    {problem && <p class="notice notice-problem" role="alert">{problem}</p>}

    {
      toAnswer.length > 0 && (
        <section class="board" aria-labelledby="answer-heading">
          <h2 id="answer-heading">Waiting for you</h2>
          <ul class="games single">
            {toAnswer.map((m) => (
              <li class="game">
                <p class="game-when">{formatDay(m.playedOn)}</p>
                <p class="game-where">{venueLabel(m.venue)}</p>
                <p class="game-who">
                  {m.reporterGames > m.opponentGames
                    ? `${m.reporterName} says they won ${m.reporterGames}–${m.opponentGames}.`
                    : `${m.reporterName} says you won ${m.opponentGames}–${m.reporterGames}.`}
                </p>
                <div class="actions">
                  <form method="post" action={`/matches/${m.id}/confirm`}>
                    <button class="button" type="submit" aria-label={`Confirm the match against ${m.reporterName}`}>
                      Confirm
                    </button>
                  </form>
                  <form method="post" action={`/matches/${m.id}/dispute`}>
                    <button
                      class="button button-quiet"
                      type="submit"
                      aria-label={`Dispute the match against ${m.reporterName}`}
                    >
                      Dispute
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="panel" aria-labelledby="record-heading">
      <h2 id="record-heading">Record a match</h2>
      <form method="post" action="/matches" class="stack-form">
        <label class="field">
          <span>Opponent's username</span>
          <input name="opponent" required autocapitalize="none" spellcheck="false" value={values.opponent} />
        </label>
        <div class="two-up">
          <label class="field">
            <span>Played on</span>
            <input type="date" name="playedOn" required min={range.min} max={range.max} value={values.playedOn} />
          </label>
          <label class="field">
            <span>Where</span>
            <select name="venue" required>
              <option value="">Choose a venue</option>
              {states.map((state) => (
                <optgroup label={state}>
                  {venues
                    .filter((v) => v.state === state)
                    .map((v) => (
                      <option value={v.id} selected={values.venue === v.id}>
                        {venueLabel(v.id)}
                      </option>
                    ))}
                </optgroup>
              ))}
            </select>
          </label>
        </div>
        <div class="two-up">
          <label class="field">
            <span>Games you won</span>
            <select name="mine">
              {gameCounts.map((n) => (
                <option value={n} selected={values.mine === n}>
                  {n}
                </option>
              ))}
            </select>
          </label>
          <label class="field">
            <span>Games they won</span>
            <select name="theirs">
              {gameCounts.map((n) => (
                <option value={n} selected={values.theirs === n}>
                  {n}
                </option>
              ))}
            </select>
          </label>
        </div>
        <button class="button" type="submit">Record match</button>
      </form>
    </section>

    {
      ownReports.length > 0 && (
        <section class="panel" aria-labelledby="own-heading">
          <h2 id="own-heading">Waiting on your opponents</h2>
          <ul class="plain-list">
            {ownReports.map((m) => (
              <li>
                {formatDay(m.playedOn)}: {m.reporterGames}–{m.opponentGames} against {m.opponentName},{" "}
                {m.status === "disputed" ? "disputed, so it won't count" : "waiting for them to confirm"}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="panel" aria-labelledby="history-heading">
      <h2 id="history-heading">Your record</h2>
      {
        record.length === 0 ? (
          <p class="muted">No confirmed matches yet.</p>
        ) : (
          <ul class="plain-list">
            {record.map((m) => (
              <li>
                {formatDay(m.playedOn)}: {m.games > m.against ? "won" : "lost"} {m.games}–{m.against} against{" "}
                <a href={`/players/${m.opponentId}`}>{m.opponentName}</a>
                {!reviewed.has(m.id) && (
                  <>
                    {" · "}
                    <a href={`/matches/${m.id}/review`}>Review their game</a>
                  </>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Base>
