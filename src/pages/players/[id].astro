---
// A member's profile, as other members see it. Anyone else gets a 403 and a
// way to sign in, and nothing about the member: the profile isn't even looked
// up for them.
import Avatar from "../../components/Avatar.astro";
import GameFields from "../../components/GameFields.astro";
import Hexagon from "../../components/Hexagon.astro";
import Base from "../../layouts/Base.astro";
import { kinds, upcomingGames } from "../../lib/games";
import { ratings, recordOf } from "../../lib/matches";
import { currentPlayer, isGuest } from "../../lib/players";
import { grips, profileOf, ratingsCentralUrl, styles } from "../../lib/profiles";
import { type Aspect, aspects, HEXAGON_AFTER, standingOf } from "../../lib/reviews";
import { formatDay, formatWhen } from "../../lib/time";
import { venueLabel } from "../../lib/venues";

const viewer = currentPlayer(Astro.cookies);
const allowed = viewer !== undefined && !isGuest(viewer);
const profile = allowed ? profileOf(String(Astro.params.id)) : undefined;
if (!allowed) Astro.response.status = 403;
else if (!profile) Astro.response.status = 404;

const games = profile ? upcomingGames().filter((g) => g.hostId === profile.id || g.guestId === profile.id) : [];
const howTheyPlay = profile
  ? [profile.grip && grips[profile.grip], profile.style && styles[profile.style]].filter(Boolean).join(" · ")
  : "";
const notGiven = "Not given";
const standing = profile ? ratings().get(profile.id) : undefined;
const record = profile ? recordOf(profile.id, 5) : [];
const opinions = profile ? standingOf(profile.id) : undefined;
const canInvite = profile !== undefined && viewer?.id !== profile.id;
const inviteProblems: Record<string, string> = {
  time: "Pick a time between now and eight weeks from now.",
  venue: "Pick one of the listed venues.",
  kind: "Choose a match or a practice.",
  note: "Keep the note to 200 characters.",
  invitee: "Only members can be invited, and not yourself.",
};
const problemKey = Astro.url.searchParams.get("problem");
const inviteProblem = problemKey && Object.hasOwn(inviteProblems, problemKey) ? inviteProblems[problemKey] : undefined;
const aspectKeys = Object.keys(aspects) as Aspect[];
---

<Base title={profile ? `${profile.name} · Find a game` : "Members only · Find a game"}>
  <main class="wrap narrow">
    {
      !allowed ? (
        <section class="panel">
          <h1>Members only</h1>
          <p class="muted">
            Profiles are for signed-in members. <a href="/login">Log in</a>, or <a href="/signup">make an account</a>
            {viewer ? " to keep your games as a member." : "."}
          </p>
        </section>
      ) : !profile ? (
        <section class="panel">
          <h1>No such member</h1>
          <p class="muted">
            Guests don't have profiles. <a href="/">Back to the board</a>
          </p>
        </section>
      ) : (
        <>
          {/* the parts that change with what members share; the invitation
              form stays put, so nothing half-typed is lost */}
          <div class="profile-head" id="profile-head" data-live-area>
            <Avatar id={profile.id} name={profile.name} photoVersion={profile.photoVersion} />
            <div>
              <h1>{profile.name}</h1>
              <p class="muted">
                @{profile.username}
                {howTheyPlay && ` · ${howTheyPlay}`}
              </p>
              {viewer?.id === profile.id && (
                <p>
                  <a href="/profile">Edit your profile</a>
                </p>
              )}
            </div>
          </div>

          {canInvite && (
            <section class="panel" aria-labelledby="invite-heading">
              <h2 id="invite-heading">Invite {profile.name} to a game</h2>
              <p class="muted">Only they can accept it, and it stays off the board until they do.</p>
              {inviteProblem && (
                <p class="notice notice-problem" role="alert">
                  {inviteProblem}
                </p>
              )}
              <form method="post" action={`/players/${profile.id}/invite`} class="post-form">
                <GameFields />
                <button class="button" type="submit">
                  Send invitation
                </button>
              </form>
            </section>
          )}

          <div id="profile-details" data-live-area>
          <section class="panel" aria-labelledby="record-heading">
            <h2 id="record-heading">Record</h2>
            <p>
              {standing ? (
                <>
                  <strong>Club rating {Math.round(standing.rating)}</strong>, unofficial, from {standing.played}{" "}
                  {standing.played === 1 ? "confirmed match" : "confirmed matches"} ({standing.won} won)
                </>
              ) : (
                "Club rating: none yet. It starts with a confirmed match."
              )}
            </p>
            {record.length > 0 && (
              <ul class="plain-list">
                {record.map((m) => (
                  <li>
                    {formatDay(m.playedOn)}: {m.games > m.against ? "won" : "lost"} {m.games}–{m.against} against{" "}
                    <a href={`/players/${m.opponentId}`}>{m.opponentName}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="panel" aria-labelledby="style-heading">
            <h2 id="style-heading">Their game, as opponents see it</h2>
            {opinions?.shown ? (
              <>
                <div class="hexagon-wrap">
                  <Hexagon name={profile.name} averages={opinions.averages} />
                  <dl class="kit">
                    {aspectKeys.map((a) => (
                      <>
                        <dt>{aspects[a]}</dt>
                        <dd>{opinions.averages[a].toFixed(1)}</dd>
                      </>
                    ))}
                  </dl>
                </div>
                <p class="muted">
                  From {opinions.reviews} reviews by {opinions.reviewers} opponents, each scoring 1 to 5.
                </p>
                {opinions.comments.length > 0 && (
                  <ul class="plain-list">
                    {opinions.comments.map((c) => (
                      <li>
                        “{c.comment}” {c.reviewerName}
                      </li>
                    ))}
                  </ul>
                )}
              </>
            ) : (
              <p class="muted">
                Shows once {HEXAGON_AFTER} different opponents have reviewed: {opinions?.reviewers ?? 0} so far.
              </p>
            )}
          </section>

          <section class="panel" aria-labelledby="kit-heading">
            <h2 id="kit-heading">Kit</h2>
            <dl class="kit">
              <dt>Blade</dt>
              <dd>{profile.blade ?? notGiven}</dd>
              <dt>Forehand</dt>
              <dd>{profile.forehand ?? notGiven}</dd>
              <dt>Backhand</dt>
              <dd>{profile.backhand ?? notGiven}</dd>
              <dt>Official rating</dt>
              <dd>
                {profile.ratingsCentralId ? (
                  <a href={ratingsCentralUrl(profile.ratingsCentralId)}>On Ratings Central</a>
                ) : (
                  notGiven
                )}
              </dd>
            </dl>
          </section>

          <section class="panel" aria-labelledby="venues-heading">
            <h2 id="venues-heading">Usually plays at</h2>
            {profile.venues.length === 0 ? (
              <p class="muted">{notGiven}</p>
            ) : (
              <ul class="chips">
                {profile.venues.map((v) => (
                  <li>{venueLabel(v)}</li>
                ))}
              </ul>
            )}
          </section>

          <section class="panel" aria-labelledby="games-heading">
            <h2 id="games-heading">Coming up</h2>
            {games.length === 0 ? (
              <p class="muted">No games coming up.</p>
            ) : (
              <ul class="plain-list">
                {games.map((g) => (
                  <li>
                    <strong>{formatWhen(g.startsAt)}</strong>, {venueLabel(g.venue)} · {kinds[g.kind]}
                    {g.status === "open" ? ", open" : ` with ${g.hostId === profile.id ? g.guestName : g.hostName}`}
                  </li>
                ))}
              </ul>
            )}
          </section>
          </div>
        </>
      )
    }
  </main>

  {
    profile && (
      <script is:inline>
        // A profile's games come from the board, which a member's own stream
        // doesn't carry, so the page also listens to the board's and swaps in
        // whichever of the same parts changed when a game is posted, taken or
        // withdrawn.
        (() => {
          if (!("EventSource" in window)) return;
          let busy = false;
          let again = false;
          const refresh = async () => {
            if (busy) {
              again = true;
              return;
            }
            busy = true;
            try {
              const res = await fetch(location.pathname, { headers: { accept: "text/html" } });
              if (!res.ok) return;
              const fresh = new DOMParser().parseFromString(await res.text(), "text/html");
              for (const id of ["profile-head", "profile-details"]) {
                const next = fresh.getElementById(id);
                const current = document.getElementById(id);
                if (next && current && next.outerHTML !== current.outerHTML) current.replaceWith(next);
              }
            } catch {
              // the next change, or a reload, catches up
            } finally {
              busy = false;
              if (again) {
                again = false;
                refresh();
              }
            }
          };
          const source = new EventSource("/live/board");
          let opened = false;
          source.addEventListener("change", refresh);
          source.addEventListener("open", () => {
            if (opened) refresh();
            opened = true;
          });
        })();
      </script>
    )
  }
</Base>
